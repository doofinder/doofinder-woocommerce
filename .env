# MySQL configuration
MYSQL_VERSION=5.7
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3310

# WordPress configuration
WORDPRESS_IMAGE_TAG=latest
WEB_SERVICE_PORT=9010
BASE_URL=http://localhost:9010

# Admin user (created on first run by docker/install-wordpress.sh)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=plugins@doofinder.com

# Apache user/group inside container (must match host UID/GID for ./html writability)
APACHE_UID=1000
APACHE_GID=1000

# Optionally pin a specific WordPress core version (consumed by docker/install-wordpress.sh)
# WORDPRESS_VERSION=6.7.1

# Whether to import WooCommerce's bundled sample products on first install.
# Default `false`; `make init-with-data` overrides to `true` for that single run.
IMPORT_SAMPLE_DATA=false

# WordPress runtime constants injected into wp-config.php via WORDPRESS_CONFIG_EXTRA.
WP_ENVIRONMENT_TYPE=local
FS_METHOD=direct

# Doofinder plugin source codegen — `make doofinder-configure` runs envsubst
# over `templates/` to regenerate the committed plugin source files. Bump
# PLUGIN_VERSION here for releases; override the URL formats in .env.local
# to point the plugin at your own ngrok stack during dev.
PLUGIN_VERSION=2.15.3
DOOFINDER_PLUGINS_URL_FORMAT=https://%splugins.doofinder.com
DOOFINDER_API_URL_FORMAT=https://%sadmin.doofinder.com
