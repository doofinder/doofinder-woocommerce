# MySQL configuration
MYSQL_VERSION=5.7
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3310

# WordPress configuration
WORDPRESS_IMAGE_TAG=latest
WEB_SERVICE_PORT=9010
LOCAL_DOMAIN=http://localhost:9010

# Admin user (created on first run by docker/install-wordpress.sh)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=developers@doofinder.com

# Apache user/group inside container (must match host UID/GID for ./html writability)
APACHE_UID=1000
APACHE_GID=1000

# Optionally pin a specific WordPress core version (consumed by docker/install-wordpress.sh)
# WORDPRESS_VERSION=6.7.1
